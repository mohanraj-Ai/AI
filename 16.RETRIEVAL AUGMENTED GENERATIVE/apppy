    "from flask import Flask, request, jsonify\n",
    "import uuid\n",
    "from functions import get_answer_from_knowledge, add_transcript, extract_lead\n",
    "import datetime\n",
    "\n",
    "app = Flask(__name__)\n",
    "\n",
    "# Store chat sessions in memory\n",
    "chat_sessions = {}\n",
    "\n",
    "@app.route(\"/start\", methods=[\"GET\"])\n",
    "def start_chat():\n",
    "    chat_id = str(uuid.uuid4())\n",
    "    chat_sessions[chat_id] = {\"history\": []}\n",
    "    return jsonify({\"chat_id\": chat_id, \"message\": \"Chat started! How can I help you today?\"})\n",
    "\n",
    "\n",
    "@app.route(\"/chat\", methods=[\"POST\"])\n",
    "def chat():\n",
    "    data = request.json\n",
    "    chat_id = data.get(\"chat_id\")\n",
    "    user_message = data.get(\"message\")\n",
    "\n",
    "    if not chat_id or chat_id not in chat_sessions:\n",
    "        return jsonify({\"error\": \"Invalid chat_id\"}), 400\n",
    "\n",
    "    if not user_message:\n",
    "        return jsonify({\"error\": \"Message is required\"}), 400\n",
    "\n",
    "    # Get answer from knowledge base\n",
    "    answer = get_answer_from_knowledge(user_message)\n",
    "\n",
    "    # Log transcript\n",
    "    transcript = {\n",
    "        \"chat_id\": chat_id,\n",
    "        \"timestamp\": datetime.datetime.now().isoformat(),\n",
    "        \"user_message\": user_message,\n",
    "        \"bot_response\": answer\n",
    "    }\n",
    "    add_transcript(transcript)\n",
    "\n",
    "    # Save lead info if present\n",
    "    lead_info = extract_lead(user_message)\n",
    "    if lead_info:\n",
    "        print(\"Lead found:\", lead_info)\n",
    "        # You can save leads to a Google Sheet or DB here\n",
    "\n",
    "    # Update chat session history\n",
    "    chat_sessions[chat_id][\"history\"].append(transcript)\n",
    "\n",
    "    return jsonify({\"response\": answer})\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    app.run(port=8080, debug=True)"
   ]
  }
